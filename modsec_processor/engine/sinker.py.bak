#!/usr/bin/env python3
"""
sinker.py - 沉底引擎核心（只处理全局规则）
"""
import os
import logging
from typing import Dict, Tuple, Optional

from config.settings import CONFIG_DIR
from providers.sink_provider import FileSinkProvider
from providers.multi_user_provider import MultiUserTempBlacklist
from providers.rule_provider import RuleProvider

logger = logging.getLogger(__name__)


class Sinker:
    """沉底引擎（只处理全局规则和黑白名单）"""

    MARKER_ACTIVE = "A"
    MARKER_BLOCKED = "B"
    MARKER_WHITELIST = "W"
    MARKER_TEMP_BLOCKED = "T"
    MARKER_RULE = "R"

    def __init__(self, config_dir: str = None):
        if config_dir is None:
            config_dir = str(CONFIG_DIR)
        self.config_dir = config_dir

        self.whitelist = FileSinkProvider(os.path.join(config_dir, "whitelist_ips.txt"))
        self.blacklist = FileSinkProvider(os.path.join(config_dir, "blocked_ips.txt"))
        self.temp_blacklist = MultiUserTempBlacklist(config_dir)
        self.rule_provider = RuleProvider(config_dir)

        logger.info("沉底引擎初始化完成（只处理全局规则）")
        logger.info(f"  白名单: {len(self.whitelist._data)} 条")
        logger.info(f"  永久黑名单: {len(self.blacklist._data)} 条")

    def should_sink(self, src_ip: str, context: Dict[str, str] = None) -> Tuple[bool, str]:
        """
        判断告警是否应沉底（只考虑全局规则和黑白名单）
        个人规则由 API 层处理
        """
        if context is None:
            context = {}

        # 1. 白名单（全局）
        if self.whitelist.contains(src_ip):
            return True, self.MARKER_WHITELIST

        # 2. 全局规则（scope: global）
        matched_rule = self.rule_provider.match_global_first(context)
        if matched_rule:
            return True, self.MARKER_RULE

        # 3. 永久黑名单（全局）
        if self.blacklist.contains(src_ip):
            return True, self.MARKER_BLOCKED

        return False, self.MARKER_ACTIVE

    def reload(self):
        self.whitelist.reload()
        self.blacklist.reload()
        self.temp_blacklist._load_all()
        self.rule_provider.reload()
        logger.info("沉底引擎数据已热重载")

    def get_stats(self) -> dict:
        return {
            'whitelist_count': len(self.whitelist._data),
            'blacklist_count': len(self.blacklist._data),
            'rule_count': len(self.rule_provider.get_global_rules()),
        }